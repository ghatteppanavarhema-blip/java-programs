import java.util.Scanner;

public class SimpleInterestCalculator {
    public static void main(String[] args) {
       
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the Principal amount (P): ");
        double principal = scanner.nextDouble();

        
        System.out.print("Enter the Annual Rate of Interest in % (R): ");
        double rate = scanner.nextDouble();

 
        System.out.print("Enter the Time period in years (T): ");
        double time = scanner.nextDouble();

   
        double simpleInterest = (principal * rate * time) / 100.0;

        System.out.println("\n--- Calculation Result ---");
        System.out.println("Principal Amount: " + principal);
        System.out.println("Interest Rate: " + rate + "%");
        System.out.println("Time Period: " + time + " years");
        System.out.println("Calculated Simple Interest: " + simpleInterest);

       
        scanner.close();
    }
}
