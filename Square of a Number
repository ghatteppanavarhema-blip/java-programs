import java.util.*;
public class SquareWithMul {
    public static void main(String[]args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        double n = sc.nextDouble();
        double square =  n * n;
        System.out.println("The square of " + n + " is: " + square);
        sc.close();
        }
    }
