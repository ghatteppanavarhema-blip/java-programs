class Student {
    
    String name;
    int rollNumber;

    
    public Student(String name, int rollNumber) {
        this.name = name;
        this.rollNumber = rollNumber;
    }

    
    public void displayDetails() {
        System.out.println("Roll No: " + rollNumber + ", Name: " + name);
    }
}

public class Main {
    public static void main(String[] args) {
        
        System.out.println("--- Approach 1: Individual Object Creation ---");
        
        Student student1 = new Student("Alice", 101);
        Student student2 = new Student("Bob", 102);


        student1.displayDetails();
        student2.displayDetails();

        
        System.out.println("\n--- Approach 2: Creating an Array of Objects ---");
        
        Student[] studentArray = new Student[3];

        
        studentArray[0] = new Student("Charlie", 103);
        studentArray[1] = new Student("Diana", 104);
        studentArray[2] = new Student("Ethan", 105);

        
        for (int i = 0; i < studentArray.length; i++) {
            studentArray[i].displayDetails();
        }
    }
}
